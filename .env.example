# Ollama Cloud API key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Largest model first. On rate-limit / token-limit errors the client falls back down the list.
OLLAMA_MODELS=gpt-oss:120b,gemma4:31b,gpt-oss:20b
# OLLAMA_BASE_URL=https://ollama.com

# Portal server. It has no login, so keep it on localhost unless something else guards it.
# FDM_HOST=127.0.0.1
# FDM_PORT=5000
# FDM_SHORTLIST_SIZE=10
# FDM_LOG_LEVEL=INFO

# Optional tuning
# FDM_OUTPUT_DIR=output
# FDM_SEARCH_QUERIES=landing page,simple website,calculator,fastapi,flask,dashboard,form,api
# FDM_RSS_FEEDS=https://example.com/gigs.rss,https://example.org/jobs.atom
# FDM_RESULTS_PER_QUERY=50
# FDM_LLM_CONCURRENCY=2

# Optional facts the proposal writer may use about you. It never invents experience, so leave them empty
# rather than guess. Example profile: "Python/Flask developer, 4 years; built booking sites for 2 clinics."
# FDM_FREELANCER_NAME=
# FDM_FREELANCER_PROFILE=

# Optional: place bids from the portal through Freelancer.com's API. Use an OAuth token for your own account
# from the Freelancer.com developer portal (https://developers.freelancer.com). Anyone with it can bid as you.
# FREELANCER_OAUTH_TOKEN=
